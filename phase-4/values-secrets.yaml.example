# values-secrets.yaml — Helm secrets override file
# Copy to values-secrets.yaml, fill in real values, then:
#   helm install todo-chatbot ./helm/todo-chatbot -f values-secrets.yaml
#
# WARNING: values-secrets.yaml is gitignored. NEVER commit real secrets.

secrets:
  # Your Neon PostgreSQL connection string
  databaseUrl: "postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require"

  # Same BETTER_AUTH_SECRET used in Phase 3 .env
  betterAuthSecret: "your-better-auth-secret-here"

  # Your Google Gemini API key (backend only)
  geminiApiKey: "your-gemini-api-key-here"

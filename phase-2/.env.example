# Database — Neon PostgreSQL connection string
DATABASE_URL=postgresql://user:password@ep-xxx-xxx-123456.us-east-1.aws.neon.tech/neondb?sslmode=require

# Auth — Shared secret for JWT signing (Better Auth + FastAPI)
BETTER_AUTH_SECRET=your-secret-key-minimum-32-characters-long

# Backend — FastAPI base URL
BACKEND_URL=http://localhost:8000

# Frontend — Public API URL for browser requests
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Frontend URL — for CORS (used by FastAPI)
FRONTEND_URL=http://localhost:3000
